local Players = game:GetService("Players")
local playerGui = Players.LocalPlayer.PlayerGui

print("[Fish] Script started")

local function runMinigame(child)
    print("[Fish] Minigame found: " .. child.Name)

    local ok1, fishIcon = pcall(function() return child.Frame.FishBar.FishIcon end)
    local ok2, reelBar  = pcall(function() return child.Frame.FishBar.ReelBar end)

    if not ok1 then print("[Fish] ERROR: FishIcon not found") return end
    if not ok2 then print("[Fish] ERROR: ReelBar not found") return end

    print("[Fish] Got FishIcon and ReelBar, starting loop")

    local ticks = 0
    while child.Parent do
        ticks += 1

        local fishTop = fishIcon.AbsolutePosition.Y
        local fishBot = fishTop + fishIcon.AbsoluteSize.Y
        local reelTop = reelBar.AbsolutePosition.Y
        local reelBot = reelTop + reelBar.AbsoluteSize.Y

        local overlapping = fishBot >= reelTop and fishTop <= reelBot

        if ticks % 5 == 0 then
            print(string.format(
                "[Fish] fishTop=%.1f fishBot=%.1f | reelTop=%.1f reelBot=%.1f | overlap=%s",
                fishTop, fishBot, reelTop, reelBot, tostring(overlapping)
            ))
        end

        if not overlapping then
            print("[Fish] NOT overlapping - pressing M1")
            mouse1press()
        else
            print("[Fish] overlapping - releasing M1")
            mouse1release()
        end

        task.wait(0.05)
    end

    mouse1release()
    print("[Fish] Minigame ended, M1 released")
end

playerGui.ChildAdded:Connect(function(child)
    if child.Name == "FishingMinigame" then
        print("[Fish] FishingMinigame detected!")
        task.spawn(runMinigame, child)
    end
end)

if playerGui:FindFirstChild("FishingMinigame") then
    task.spawn(runMinigame, playerGui.FishingMinigame)
end

print("[Fish] Waiting for minigame...")
